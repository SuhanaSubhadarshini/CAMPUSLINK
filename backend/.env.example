# Copy to backend/.env; shell environment variables override these defaults.
# Defaults use absolute paths relative to backend/.
# DATABASE_URL=sqlite:///./campuslink.db
SEED_DEMO=true
# UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Optional Adzuna connection. Never commit real values. Restart backend after changes.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
